{
  "name": "image-to-vector-button",
  "displayName": "Image to Vector (Chat & Topbar Button)",
  "description": "Nút chọn thư mục ảnh đầu ra và kéo thả ảnh ngay trên ô nhập chat và topbar của Antigravity.",
  "version": "1.2.0",
  "publisher": "Neito",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "imageToVector.selectOutputDir",
        "title": "📂 Chọn thư mục ảnh đầu ra",
        "icon": "$(folder-opened)",
        "category": "ImageToVector"
      },
      {
        "command": "imageToVector.openDropzone",
        "title": "🖼️ Vectorize Image (Drag & Drop)",
        "icon": "$(file-media)",
        "category": "ImageToVector"
      }
    ],
    "menus": {
      "chat/title": [
        {
          "command": "imageToVector.selectOutputDir",
          "group": "navigation@1"
        },
        {
          "command": "imageToVector.openDropzone",
          "group": "navigation@2"
        }
      ],
      "chat/input/status": [
        {
          "command": "imageToVector.selectOutputDir",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "imageToVector.selectOutputDir",
          "group": "navigation@1"
        },
        {
          "command": "imageToVector.openDropzone",
          "group": "navigation@2"
        }
      ]
    }
  }
}
